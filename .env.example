# FOFA credentials. FOFA_API_KEY is preferred; FOFA_KEY is a legacy alias.
FOFA_API_KEY=
FOFA_EMAIL=

# Service authentication. Required when binding REST/MCP HTTP beyond loopback.
FOFAMAP_SERVICE_TOKEN=replace-with-a-long-random-value
FOFAMAP_BIND_HOST=127.0.0.1
FOFAMAP_DATABASE_URL=sqlite:///./fofamap.sqlite3
FOFAMAP_ARTIFACT_RETENTION_DAYS=7

# Provider keys are referenced by name from settings.yaml; never put values there.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
XAI_API_KEY=
MINIMAX_API_KEY=
MIMO_API_KEY=
MOONSHOT_API_KEY=
SILICONFLOW_API_KEY=
GEMINI_API_KEY=

# Active scanning is opt-in and requires a one-time approval token.
FOFAMAP_ENABLE_SCANNING=false
FOFAMAP_SCAN_APPROVAL_SECRET=
FOFAMAP_NUCLEI_TEMPLATE_ALLOWLIST=
FOFAMAP_NUCLEI_ID_ALLOWLIST=
FOFAMAP_ALLOW_PRIVATE_NETWORK=false

# Required for non-loopback MCP Streamable HTTP protected-resource metadata.
FOFAMAP_MCP_ISSUER_URL=https://auth.example.com
FOFAMAP_MCP_RESOURCE_URL=https://fofamap.example.com/mcp
FOFAMAP_JWT_PUBLIC_KEY=
FOFAMAP_JWT_ISSUER=
FOFAMAP_JWT_AUDIENCE=fofamap
